{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sona://meeting-assistant/v1/event-minutes-state-changed.schema.json",
  "title": "MinutesStateChangedEvent",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "type", "event_id", "meeting_id", "occurred_at", "payload"],
  "properties": {
    "contract_version": {"const": "1"},
    "type": {"const": "minutes_state_changed"},
    "event_id": {"type": "string", "format": "uuid"},
    "meeting_id": {"type": "string", "minLength": 1},
    "occurred_at": {"type": "string", "format": "date-time"},
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["minutes_id", "version", "status", "error_code", "error_message", "minutes"],
      "properties": {
        "minutes_id": {"type": "string", "format": "uuid"},
        "version": {"type": "integer", "minimum": 1},
        "status": {"enum": ["queued", "generating", "completed", "failed"]},
        "error_code": {"type": ["string", "null"]},
        "error_message": {"type": ["string", "null"]},
        "generation_stats": {
          "type": ["array", "null"],
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["stage", "model", "duration_seconds"],
            "properties": {
              "stage": {"type": "string"},
              "model": {"type": "string"},
              "duration_seconds": {"type": "number", "minimum": 0},
              "input_tokens": {"type": "integer", "minimum": 0},
              "total_output_tokens": {"type": "integer", "minimum": 0},
              "reasoning_output_tokens": {"type": "integer", "minimum": 0},
              "tokens_per_second": {"type": "number", "minimum": 0},
              "time_to_first_token_seconds": {"type": "number", "minimum": 0}
            }
          }
        },
        "minutes": {
          "anyOf": [
            {"type": "null"},
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "meeting_id", "version", "status", "source_content_revision", "model", "prompt_version", "content_json", "content_markdown", "raw_output", "error_code", "error_message", "created_at", "is_stale"],
              "properties": {
                "id": {"type": "string", "format": "uuid"},
                "meeting_id": {"type": "string", "format": "uuid"},
                "version": {"type": "integer", "minimum": 1},
                "status": {"enum": ["queued", "generating", "completed", "failed"]},
                "source_content_revision": {"type": "integer", "minimum": 0},
                "model": {"type": "string"},
                "prompt_version": {"type": ["string", "null"]},
                "content_json": {"type": ["object", "null"]},
                "content_markdown": {"type": ["string", "null"]},
                "raw_output": {"type": ["string", "null"]},
                "error_code": {"type": ["string", "null"]},
                "error_message": {"type": ["string", "null"]},
                "created_at": {"type": "string", "format": "date-time"},
                "is_stale": {"type": "boolean"}
              }
            }
          ]
        }
      }
    }
  }
}
