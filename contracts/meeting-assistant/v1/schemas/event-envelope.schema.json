{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sona://meeting-assistant/v1/event-envelope.schema.json",
  "title": "MeetingEventEnvelope",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "type", "event_id", "meeting_id", "occurred_at", "payload"],
  "properties": {
    "contract_version": {"const": "1"},
    "type": {"enum": ["meeting_snapshot", "meeting_state_changed", "transcript_partial", "transcript_reconciled", "speaker_updated", "meeting_title_updated", "minutes_state_changed", "health_changed", "transcription_gap", "resync_required"]},
    "event_id": {"type": "string", "format": "uuid"},
    "meeting_id": {"type": "string"},
    "occurred_at": {"type": "string", "format": "date-time"},
    "payload": {"type": "object"}
  }
}
