{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "voice-studio://meeting-assistant/v1/event-health-changed.schema.json",
  "title": "HealthChangedEvent",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "type", "event_id", "meeting_id", "occurred_at", "payload"],
  "properties": {
    "contract_version": {"const": "1"},
    "type": {"const": "health_changed"},
    "event_id": {"type": "string", "format": "uuid"},
    "meeting_id": {"type": "string", "minLength": 1},
    "occurred_at": {"type": "string", "format": "date-time"},
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["storage", "transcription", "mic_muted", "recovery_journal_active"],
      "properties": {
        "storage": {"type": "string"},
        "transcription": {"type": "string"},
        "mic_muted": {"type": "boolean"},
        "recovery_journal_active": {"type": "boolean"}
      }
    }
  }
}
