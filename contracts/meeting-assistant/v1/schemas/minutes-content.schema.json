{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sona://meeting-assistant/v1/minutes-content.schema.json",
  "title": "MinutesContentJson",
  "type": "object",
  "additionalProperties": false,
  "required": ["overview", "topics", "decisions", "action_items", "risks", "open_questions", "highlights"],
  "properties": {
    "title": {"type": ["string", "null"], "maxLength": 64},
    "overview": {"type": "string", "minLength": 1, "maxLength": 3000},
    "topics": {"type": "array", "maxItems": 12, "items": {"$ref": "#/$defs/topic"}},
    "decisions": {"type": "array", "maxItems": 12, "items": {"$ref": "#/$defs/decision"}},
    "action_items": {"type": "array", "maxItems": 12, "items": {"$ref": "#/$defs/action_item"}},
    "risks": {"type": "array", "maxItems": 8, "items": {"$ref": "#/$defs/evidence_item"}},
    "open_questions": {"type": "array", "maxItems": 8, "items": {"$ref": "#/$defs/evidence_item"}},
    "highlights": {"type": "array", "maxItems": 12, "items": {"$ref": "#/$defs/evidence_item"}}
  },
  "$defs": {
    "evidence_ids": {
      "type": "array",
      "maxItems": 6,
      "items": {"type": "string", "format": "uuid"}
    },
    "topic": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "summary", "evidence_segment_ids"],
      "properties": {
        "title": {"type": "string", "minLength": 1, "maxLength": 200},
        "summary": {"type": "string", "minLength": 1, "maxLength": 1000},
        "evidence_segment_ids": {"$ref": "#/$defs/evidence_ids"}
      }
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["content", "evidence_segment_ids"],
      "properties": {
        "content": {"type": "string", "minLength": 1, "maxLength": 1000},
        "evidence_segment_ids": {"$ref": "#/$defs/evidence_ids"}
      }
    },
    "action_item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["task", "owner", "due_date", "evidence_segment_ids"],
      "properties": {
        "task": {"type": "string", "minLength": 1, "maxLength": 1000},
        "owner": {"type": ["string", "null"], "maxLength": 200},
        "due_date": {"type": ["string", "null"], "maxLength": 64},
        "evidence_segment_ids": {"$ref": "#/$defs/evidence_ids"}
      }
    },
    "evidence_item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["content", "evidence_segment_ids"],
      "properties": {
        "content": {"type": "string", "minLength": 1, "maxLength": 1000},
        "evidence_segment_ids": {"$ref": "#/$defs/evidence_ids"}
      }
    }
  }
}
